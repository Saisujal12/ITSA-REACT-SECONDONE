PORT=5000
NODE_ENV=development

FRONTEND_ORIGIN=http://localhost:5173

EVENT_SHEET_ID_LLM=

EVENT_SHEET_ID_CODE_BUILD=

EVENT_SHEET_ID_INNOVATION=

EVENT_SHEET_ID_CYBER_QUEST=

EVENT_SHEET_ID_DESIGN_DEPLOY=

EVENT_SHEET_ID_TECH_CONNECT=

EVENT_SHEET_ID_EVENT6=

EVENT_SHEET_ID_EVENT7=

EVENT_SHEET_ID_EVENT8=

EVENT_SHEET_ID_EVENT9=

EVENT_SHEET_ID_EVENT10=

GOOGLE_SHEET_TAB_NAME=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Or use GOOGLE_SERVICE_ACCOUNT_JSON=


# Create a private Drive folder, share it with the service account as Editor,
# and set its folder ID here. Share the folder with payment reviewers as needed.
PAYMENT_SCREENSHOT_FOLDER_ID=


# Optional: authorize screenshot uploads as a personal Google account.
# If all three values are set, Drive uploads use this Gmail account; Sheets
# continue using the service account above. Keep the refresh token secret.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=




SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=IT Association | KITSW

ADMIN_USERNAME=admin
# Use a different password for every selection. Generate each hash with:
# npm run hash-admin-password -- llm  (run from the server folder; replace llm with the event ID)
ADMIN_PASSWORD_HASH_LLM=
ADMIN_PASSWORD_HASH_CODE_BUILD=
ADMIN_PASSWORD_HASH_INNOVATION=
ADMIN_PASSWORD_HASH_CYBER_QUEST=
ADMIN_PASSWORD_HASH_DESIGN_DEPLOY=
ADMIN_PASSWORD_HASH_TECH_CONNECT=
ADMIN_PASSWORD_HASH_EVENT6=
ADMIN_PASSWORD_HASH_EVENT7=
ADMIN_PASSWORD_HASH_EVENT8=
ADMIN_PASSWORD_HASH_EVENT9=
ADMIN_PASSWORD_HASH_EVENT10=
ADMIN_SESSION_SECRET=


TRANSACTION_REGISTRY_URL=
TRANSACTION_REGISTRY_SECRET=

VITE_API_URL=
DEV_API_PROXY_TARGET=http://127.0.0.1:5000